               </property>
              </widget>
             </item>
            </layout>
           </item>
           <item>
            <widget class="QLabel" name="instructions">
             <property name="text">
              <string>&lt;b&gt;How to use&lt;/b&gt;&lt;ol style=&quot;margin-left:-20px&quot;&gt;&lt;li&gt;Add capture files (or drag them onto this window).&lt;/li&gt;&lt;li&gt;Add one or more Wireshark &lt;i&gt;display&lt;/i&gt; filters. An empty filter counts every packet.&lt;/li&gt;&lt;li&gt;Click &lt;b&gt;Search Now&lt;/b&gt;, or tick &lt;b&gt;Live Search&lt;/b&gt; to update as you go.&lt;/li&gt;&lt;/ol&gt;Each result is the number of packets in that capture matching that filter. Hover over a cell to see tshark's messages.</string>
             </property>
             <property name="textFormat">
              <enum>Qt::RichText</enum>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
             <property name="alignment">
              <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
             </property>
            </widget>
